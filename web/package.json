{
  "name": "sinomed-web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "npm run lint:js && npm run lint:prettier && npm run tsc",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src ",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "openapi": "max openapi",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^4.8.3",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/use-emotion-css": "1.0.4",
    "@umijs/route-utils": "^2.2.2",
    "antd": "^5.29.3",
    "classnames": "^2.5.1",
    "dayjs": "1.11.23",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "omit.js": "^2.0.2",
    "pinyin-pro": "^3.29.5",
    "querystring": "^0.2.1",
    "rc-menu": "^9.16.1",
    "rc-util": "^5.44.4",
    "react": "^18.3.1",
    "react-dev-inspector": "^1.9.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^2.1.5",
    "@testing-library/react": "^13.4.0",
    "@types/classnames": "^2.3.4",
    "@types/express": "^4.17.25",
    "@types/history": "^4.7.11",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.27",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-helmet": "^6.1.11",
    "@umijs/fabric": "^2.14.1",
    "@umijs/lint": "^4.7.28",
    "@umijs/max": "^4.7.28",
    "cross-env": "^7.0.3",
    "eslint": "8.35.0",
    "express": "^4.22.3",
    "gh-pages": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^10.5.4",
    "prettier": "^2.8.8",
    "swagger-ui-dist": "^4.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "form-data@2.3.3": "2.5.6",
      "immer@8": "9.0.21",
      "axios@0.27.2": "0.34.0",
      "postcss@7": "8.5.28",
      "node-fetch@1": "2.7.0",
      "tough-cookie@2": "4.1.4",
      "underscore@1.7.0": "1.13.8",
      "node-fetch@2.6.0": "2.7.0",
      "debug@0.7.4": "2.6.9",
      "path-to-regexp@1.7.0": "1.9.0",
      "path-to-regexp@8.2.0": "8.4.0",
      "@babel/core@7.23.6": "7.29.6",
      "log4js@1.1.1": "6.4.0",
      "esbuild@0.18.20": "0.25.0",
      "qs@6.5.5": "6.16.0",
      "uuid@3.4.0": "11.1.1",
      "decode-uri-component@0.2.2": "0.5.0",
      "postcss-selector-parser@6.1.4": "7.1.6",
      "react-router@6.3.0": "6.30.6",
      "esbuild@0.21.4": "0.25.0",
      "@babel/runtime@7.23.6": "7.29.10",
      "vite@<7.3.7": "7.3.7"
    }
  }
}
